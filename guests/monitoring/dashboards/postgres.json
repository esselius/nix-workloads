{
  "uid": "postgres",
  "title": "PostgreSQL",
  "description": "Home Assistant recorder database: availability, size, connections, transaction rate, cache hit ratio and lock/temp pressure.",
  "tags": ["database", "postgres", "home-assistant", "risk"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "PostgreSQL up",
      "description": "postgres_exporter can connect to the recorder database.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ]
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "pg_exporter_last_scrape_error{job=\"postgres\"} == 0", "instant": true }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Recorder DB size",
      "description": "Size of the hass database.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "pg_database_size_bytes{job=\"postgres\",datname=\"hass\"}", "instant": true }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Connections",
      "description": "Backends connected to hass versus the server's max_connections.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 80 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(pg_stat_database_numbackends{job=\"postgres\",datname=\"hass\"})", "legendFormat": "backends", "instant": true },
        { "refId": "B", "expr": "max(pg_settings_max_connections{job=\"postgres\"})", "legendFormat": "max", "instant": true }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Deadlocks (24h)",
      "description": "New deadlocks in the last 24 hours.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(pg_stat_database_deadlocks{job=\"postgres\",datname=\"hass\"}[24h]) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Database size",
      "description": "Recorder database and WAL/other databases over time.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_database_size_bytes{job=\"postgres\"}",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Connections by state",
      "description": "Active, idle and idle-in-transaction backends.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_activity_count{job=\"postgres\"}",
          "legendFormat": "{{datname}} {{state}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Transactions",
      "description": "Commit and rollback rate for the recorder database.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_xact_commit{job=\"postgres\",datname=\"hass\"}[5m])",
          "legendFormat": "commit"
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_database_xact_rollback{job=\"postgres\",datname=\"hass\"}[5m])",
          "legendFormat": "rollback"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "Shared buffer hit ratio. A falling value means the working set no longer fits in cache.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_blks_hit{job=\"postgres\",datname=\"hass\"}[5m])) / clamp_min(sum(rate(pg_stat_database_blks_hit{job=\"postgres\",datname=\"hass\"}[5m])) + sum(rate(pg_stat_database_blks_read{job=\"postgres\",datname=\"hass\"}[5m])), 1) * 100",
          "legendFormat": "hass"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Temp bytes",
      "description": "Temporary bytes written by the recorder. Sustained values mean sorts/hashes spill to disk.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "Bps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_temp_bytes{job=\"postgres\",datname=\"hass\"}[5m])",
          "legendFormat": "temp"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Longest transaction",
      "description": "Age of the longest-running transaction by state. Long idle-in-transaction sessions hold back vacuum.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_activity_max_tx_duration{job=\"postgres\"}",
          "legendFormat": "{{datname}} {{state}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Locks",
      "description": "Lock counts by mode and database.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_locks_count{job=\"postgres\"}",
          "legendFormat": "{{datname}} {{mode}}"
        }
      ]
    }
  ]
}
