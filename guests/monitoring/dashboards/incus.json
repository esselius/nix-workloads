{
  "uid": "incus",
  "title": "Incus instances",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(incus_boot_time_seconds, host)",
        "definition": "label_values(incus_boot_time_seconds, host)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "regex": ""
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(incus_memory_MemTotal_bytes{host=~\"$host\"}, name)",
        "definition": "label_values(incus_memory_MemTotal_bytes{host=~\"$host\"}, name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "regex": ""
      },
      {
        "name": "type",
        "label": "Type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(incus_boot_time_seconds{host=~\"$host\"}, type)",
        "definition": "label_values(incus_boot_time_seconds{host=~\"$host\"}, type)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "regex": ""
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Instances",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "count(incus_boot_time_seconds{host=~\"$host\", name=~\"$instance\", type=~\"$type\"})", "instant": true } ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total memory used",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 5, "w": 5, "x": 4, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(incus_memory_MemTotal_bytes{host=~\"$host\", name=~\"$instance\", type=~\"$type\"} - incus_memory_MemAvailable_bytes{host=~\"$host\", name=~\"$instance\", type=~\"$type\"})", "instant": true } ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "OOM kills",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 5, "w": 5, "x": 9, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [ { "refId": "A", "expr": "sum(increase(incus_memory_OOM_kills_total{host=~\"$host\", name=~\"$instance\", type=~\"$type\"}[24h]))", "instant": true } ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total processes",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 5, "w": 5, "x": 14, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(incus_procs_total{host=~\"$host\", name=~\"$instance\", type=~\"$type\"})", "instant": true } ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Containers / VMs",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 5, "w": 5, "x": 19, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "count by (host, type) (incus_boot_time_seconds{host=~\"$host\", name=~\"$instance\", type=~\"$type\"})", "instant": true, "legendFormat": "{{host}} {{type}}" } ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU (cores)",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (host, name) (rate(incus_cpu_seconds_total{host=~\"$host\", name=~\"$instance\", type=~\"$type\"}[5m]))", "legendFormat": "{{host}} / {{name}}" } ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memory used",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "incus_memory_MemTotal_bytes{host=~\"$host\", name=~\"$instance\", type=~\"$type\"} - incus_memory_MemAvailable_bytes{host=~\"$host\", name=~\"$instance\", type=~\"$type\"}", "legendFormat": "{{host}} / {{name}}" } ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory used %",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "(1 - incus_memory_MemAvailable_bytes{host=~\"$host\", name=~\"$instance\", type=~\"$type\"} / incus_memory_MemTotal_bytes{host=~\"$host\", name=~\"$instance\", type=~\"$type\"}) * 100", "legendFormat": "{{host}} / {{name}}" } ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Disk I/O",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(incus_disk_read_bytes_total{host=~\"$host\", name=~\"$instance\", type=~\"$type\"}[5m])", "legendFormat": "{{host}} / {{name}} read" },
        { "refId": "B", "expr": "-rate(incus_disk_written_bytes_total{host=~\"$host\", name=~\"$instance\", type=~\"$type\"}[5m])", "legendFormat": "{{host}} / {{name}} write" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Network",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(incus_network_receive_bytes_total{host=~\"$host\", name=~\"$instance\", type=~\"$type\"}[5m])", "legendFormat": "{{host}} / {{name}} rx" },
        { "refId": "B", "expr": "-rate(incus_network_transmit_bytes_total{host=~\"$host\", name=~\"$instance\", type=~\"$type\"}[5m])", "legendFormat": "{{host}} / {{name}} tx" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Processes",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "incus_procs_total{host=~\"$host\", name=~\"$instance\", type=~\"$type\"}", "legendFormat": "{{host}} / {{name}}" } ]
    }
  ]
}
