{
  "uid": "wireguard",
  "title": "WireGuard",
  "description": "WireGuard peers on both hosts: handshake age, transferred bytes and per-peer state. A stale handshake on a keepalive peer means the tunnel is down.",
  "tags": ["network", "wireguard", "vpn", "host", "risk"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Peers",
      "description": "Configured WireGuard peers per host.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "count by (host) (wireguard_latest_handshake_seconds{job=\"wireguard\"})", "legendFormat": "{{host}}", "instant": true }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Stale handshakes",
      "description": "Peers whose last handshake is older than 3 minutes. The router and direct peers use 25s keepalives, so this should normally be zero.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(wireguard_latest_handshake_delay_seconds{job=\"wireguard\"} > 180) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "wg0 links up",
      "description": "Hosts whose wg0 interface reports up.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(node_network_up{node_type=\"host\",device=\"wg0\"})", "instant": true }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Throughput",
      "description": "Current receive + transmit rate across WireGuard peers.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "Bps", "min": 0, "decimals": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(wireguard_received_bytes_total{job=\"wireguard\"}[5m]) + rate(wireguard_sent_bytes_total{job=\"wireguard\"}[5m])) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Handshake age",
      "description": "Seconds since each peer's last handshake. Keepalive peers should stay well below 3 minutes.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 120 }, { "color": "red", "value": 180 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wireguard_latest_handshake_delay_seconds{job=\"wireguard\"}",
          "legendFormat": "{{host}} {{allowed_ips}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Peer throughput",
      "description": "Receive and transmit rate per peer.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "Bps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(wireguard_received_bytes_total{job=\"wireguard\"}[5m])",
          "legendFormat": "{{host}} {{allowed_ips}} rx"
        },
        {
          "refId": "B",
          "expr": "-rate(wireguard_sent_bytes_total{job=\"wireguard\"}[5m])",
          "legendFormat": "{{host}} {{allowed_ips}} tx"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cumulative bytes",
      "description": "Total bytes exchanged with each peer since the interface came up.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "wireguard_received_bytes_total{job=\"wireguard\"}", "legendFormat": "{{host}} {{allowed_ips}} rx" },
        { "refId": "B", "expr": "wireguard_sent_bytes_total{job=\"wireguard\"}", "legendFormat": "{{host}} {{allowed_ips}} tx" }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Peers",
      "description": "Current peer state. `allowed_ips` identifies the router peer and the direct cross-host peer.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host, interface, allowed_ips) (wireguard_latest_handshake_delay_seconds{job=\"wireguard\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "max by (host, allowed_ips) (wireguard_received_bytes_total{job=\"wireguard\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "max by (host, allowed_ips) (wireguard_sent_bytes_total{job=\"wireguard\"})",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "interface": true } } }
      ]
    }
  ]
}
