{
  "uid": "nodes",
  "title": "Nodes",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(up{node_type=\"host\"}, host)",
        "definition": "label_values(up{node_type=\"host\"}, host)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "regex": ""
      },
      {
        "name": "device",
        "label": "Network device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(node_network_up{node_type=\"host\",device!~\"lo|veth.*|br-.*|incusbr.*\"}, device)",
        "definition": "label_values(node_network_up{node_type=\"host\",device!~\"lo|veth.*|br-.*|incusbr.*\"}, device)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "regex": ""
      },
      {
        "name": "mountpoint",
        "label": "Mountpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(node_filesystem_size_bytes{node_type=\"host\",fstype!~\"tmpfs|overlay|squashfs|ramfs|autofs\"}, mountpoint)",
        "definition": "label_values(node_filesystem_size_bytes{node_type=\"host\",fstype!~\"tmpfs|overlay|squashfs|ramfs|autofs\"}, mountpoint)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "regex": ""
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by (host) (rate(node_cpu_seconds_total{host=~\"$host\", mode=\"idle\", node_type!=\"container\"}[5m])) * 100)",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory used",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - node_memory_MemAvailable_bytes{host=~\"$host\", node_type!=\"container\"} / node_memory_MemTotal_bytes{host=~\"$host\", node_type!=\"container\"}) * 100",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Load average",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "node_load1{host=~\"$host\", node_type!=\"container\"}", "legendFormat": "{{host}} 1m" },
        { "refId": "B", "expr": "node_load5{host=~\"$host\", node_type!=\"container\"}", "legendFormat": "{{host}} 5m" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Disk used",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - node_filesystem_avail_bytes{mountpoint=~\"$mountpoint\", host=~\"$host\", fstype!~\"tmpfs|overlay|squashfs|ramfs|autofs\",node_type!=\"container\"} / node_filesystem_size_bytes{mountpoint=~\"$mountpoint\", host=~\"$host\", fstype!~\"tmpfs|overlay|squashfs|ramfs|autofs\",node_type!=\"container\"}) * 100",
          "legendFormat": "{{host}} {{mountpoint}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Network throughput",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{device=~\"$device\", host=~\"$host\", device!~\"lo|veth.*|br-.*|incus.*\", node_type!=\"container\"}[5m])",
          "legendFormat": "{{host}} {{device}} rx"
        },
        {
          "refId": "B",
          "expr": "-rate(node_network_transmit_bytes_total{device=~\"$device\", host=~\"$host\", device!~\"lo|veth.*|br-.*|incus.*\", node_type!=\"container\"}[5m])",
          "legendFormat": "{{host}} {{device}} tx"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "dtdurations" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "time() - node_boot_time_seconds{host=~\"$host\", node_type!=\"container\"}", "legendFormat": "{{host}}" }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "btrfs checksum errors (1h)",
      "description": "New btrfs device checksum failures (corruption errors) in the last hour. Any non-zero value means the NVMe returned data that did not match its checksum.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (increase(node_btrfs_device_errors_total{host=~\"$host\", type=\"corruption\", node_type=\"host\"}[1h]))",
          "legendFormat": "{{host}}"
        }
      ]
    }
  ]
}
